// Prisma schema for the NHL Player Attribute Voting site.
//
// Runs on libSQL / SQLite (Turso in production, a local file in dev) via
// the `@prisma/adapter-libsql` driver adapter — see src/lib/prisma.ts.
// `DATABASE_URL` is only read by the Prisma CLI (migrate / studio); the
// app connects through the adapter using TURSO_DATABASE_URL +
// TURSO_AUTH_TOKEN, falling back to the local file when those are unset.
//
// SQLite has no native enum type, so the former Position / PlayerStatus /
// ReportType / ReportStatus enums are plain strings here. The allowed
// values live in the app layer (src/lib/attributes.ts, src/lib/db-enums.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id            String   @id // NHL abbreviation, e.g. "TOR"
  name          String
  city          String
  conference    String
  division      String
  primaryColor  String
  secondaryColor String
  logoLight     String
  logoDark      String
  players       Player[]
  updatedAt     DateTime @updatedAt
}

model Player {
  id            String        @id @default(cuid())
  nhlId         Int           @unique
  firstName     String
  lastName      String
  position      String        // "C" | "LW" | "RW" | "D" | "G"
  status        String        @default("ACTIVE") // "ACTIVE" | "RETIRED" | "INJURED"
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id])
  headshotUrl   String?
  heightInches  Int?
  weightPounds  Int?
  birthDate     String?
  birthCountry  String?
  votes         AttributeVote[]
  reports       Report[]
  favorites     Favorite[]
  comments      Comment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([position])
  @@index([status])
  @@index([lastName])
}

// One row per individual vote. We need full records (not just running
// totals) to support the rolling 24h cooldown per voter+attribute, spike
// detection, and admin reporting.
/**
 * One row per attribute per submission. A "submission" is one voter's take
 * on one player, cast in a single Submit — every attribute row from that
 * Submit shares a `submissionId`. The write path deletes a voter's earlier
 * rows for a player before inserting the new ones, so at read time there is
 * exactly one live row per (voter, player, attribute) and scoring is a
 * plain AVG(value). `voterKey` = userId when signed in, else voterToken.
 */
model AttributeVote {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  attribute    String   // see src/lib/attributes.ts
  value        Int      // -100 … +100
  submissionId String   // shared by every attribute row from one Submit
  voterKey     String   // userId if signed in, else voterToken — the dedup identity
  voterToken   String   // always the browser token (for the anon 10-player cap + claim-on-signup)
  voterHash    String   // sha256(ip + user-agent + salt) — abuse guard only
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /** "YYYY-MM-DD" in the voter's local timezone — gates the once-per-day re-vote for accounts. */
  localDay     String
  createdAt    DateTime @default(now())

  @@index([playerId, attribute])
  @@index([playerId, voterKey])
  @@index([voterToken])
  @@index([userId, playerId])
  @@index([submissionId])
  // Homepage "risers since Monday" and the week/month rankings windows all
  // filter AttributeVote by createdAt with no other narrowing column.
  @@index([createdAt])
  @@index([playerId, createdAt])
}

// One row per person who's ever left a player's watchlist star, or a
// comment — both require an account (unlike voting, which stays anonymous).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, playerId])
  @@index([playerId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([userId, createdAt])
}

// --- Auth.js (NextAuth v5) models --------------------------------------
// Standard shape expected by @auth/prisma-adapter. Credentials sign-in
// (passwordHash) and Google OAuth (via Account) both resolve to one User.

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  // Only set for email/password accounts; null for Google-only users.
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  votes         AttributeVote[]
  favorites     Favorite[]
  comments      Comment[]
  resetTokens   PasswordResetToken[]
  createdAt     DateTime   @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// "Forgot password" flow. Separate from VerificationToken (which Auth.js
// reserves for its Email/magic-link provider — unused here) so the two
// never collide if that provider is ever added. `token` stores a sha256
// hash of the emailed value, never the raw token (see lib/password-reset.ts).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Report {
  id          String    @id @default(cuid())
  type        String    // "DATA_ISSUE" | "VOTE_SPIKE"
  status      String    @default("OPEN") // "OPEN" | "RESOLVED" | "DISMISSED"
  playerId    String?
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  message     String
  metaJson    String?   // extra context, e.g. spike counts or reporter note
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([type])
}
