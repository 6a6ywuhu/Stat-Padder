// Prisma schema for the NHL Player Attribute Voting site.
//
// Runs on Postgres. `DATABASE_URL` is the pooled connection used by the
// app at runtime (serverless-friendly); `DIRECT_URL` is a direct,
// non-pooled connection used only by `prisma migrate` / introspection.
// On Neon these are the "-pooler" and plain hostnames respectively; for a
// plain local Postgres, point both at the same URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Position {
  C
  LW
  RW
  D
  G
}

enum PlayerStatus {
  ACTIVE
  RETIRED
  INJURED
}

enum ReportType {
  DATA_ISSUE
  VOTE_SPIKE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Team {
  id            String   @id // NHL abbreviation, e.g. "TOR"
  name          String
  city          String
  conference    String
  division      String
  primaryColor  String
  secondaryColor String
  logoLight     String
  logoDark      String
  players       Player[]
  updatedAt     DateTime @updatedAt
}

model Player {
  id            String        @id @default(cuid())
  nhlId         Int           @unique
  firstName     String
  lastName      String
  position      Position
  status        PlayerStatus  @default(ACTIVE)
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id])
  headshotUrl   String?
  heightInches  Int?
  weightPounds  Int?
  birthDate     String?
  birthCountry  String?
  votes         AttributeVote[]
  reports       Report[]
  favorites     Favorite[]
  comments      Comment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([position])
  @@index([status])
  @@index([lastName])
}

// One row per individual vote. We need full records (not just running
// totals) to support the rolling 24h cooldown per voter+attribute, spike
// detection, and admin reporting.
model AttributeVote {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  attribute   String   // e.g. "mobility", "shooting" ... see src/lib/attributes.ts
  value       Int      // +1 or -1
  voterToken  String   // cookie/localStorage token — used for the rolling cooldown
  voterHash   String   // sha256(ip + user-agent + salt) — abuse guard only
  // Set when the voter was signed in. Never surfaced on public player/team
  // pages (those only ever show aggregate net counts) — only the voter
  // themselves can see it, via their own account's vote history.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([playerId, attribute])
  @@index([voterToken, playerId, attribute])
  @@index([voterHash, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// One row per person who's ever left a player's watchlist star, or a
// comment — both require an account (unlike voting, which stays anonymous).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, playerId])
  @@index([playerId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

// --- Auth.js (NextAuth v5) models --------------------------------------
// Standard shape expected by @auth/prisma-adapter. Credentials sign-in
// (passwordHash) and Google OAuth (via Account) both resolve to one User.

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  // Only set for email/password accounts; null for Google-only users.
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  votes         AttributeVote[]
  favorites     Favorite[]
  comments      Comment[]
  createdAt     DateTime   @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Report {
  id          String       @id @default(cuid())
  type        ReportType
  status      ReportStatus @default(OPEN)
  playerId    String?
  player      Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)
  message     String
  metaJson    String?      // extra context, e.g. spike counts or reporter note
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([type])
}
